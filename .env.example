# ==========================================
# SONORA Music System — Environment Variables
# ==========================================

# Port (optional, default 3000)
PORT=3000

# Base URL for Web and Mobile client resolution
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk Authentication (Optional if using local database auth)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Supabase (Optional — system automatically uses local disk json storage when not configured)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI API Key (Optional for Aria AI Chatbot — includes full local offline neural engine fallback)
OPENAI_API_KEY=
